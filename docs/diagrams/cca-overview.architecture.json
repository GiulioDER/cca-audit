  "cards": [
    {
      "dot": "amber",
      "title": "Tiers",
      "items": [
        "FAST: CODE, BUG and SEC only; L2.5 on P1; no L2.6, L5.5 or L5.6",
        "STANDARD: six core auditors plus domain flags; L2.5 on P1 and P2; red to green tests",
        "DEEP: forced by high stakes, numeric code or hunt mode; adds a 2 of 3 adversarial panel on high stakes P1"
      ]
    },
    {
      "dot": "emerald",
      "title": "Tool evidence first",
      "items": [
        "Python and Rust claims are settled by pyright, semgrep, pytest, hypothesis or clippy",
        "An LLM may not overturn a tool verdict; it adjudicates UNCERTAIN only",
        "A missing tool or unknown language returns UNCERTAIN, never a pass"
      ]
    },
    {
      "dot": "rose",
      "title": "The gate",
      "items": [
        "Every layer is recorded with pipeline record, which refuses gaps and wrong counts",
        "The commit guard blocks git commit until every owed layer is recorded and L6 is APPROVED",
        "Codex has no hooks: pipeline status --require-complete is its gate"
      ]
    },
    {
      "dot": "violet",
      "title": "Not drawn",
      "items": [
        "L2.6 auditor scorecard, recorded by its tool on STANDARD and DEEP",
        "no-fix and p1-only modes; the deferred second pass for P3",
        "Pause and resume at a layer boundary"
      ]
    }
  ]
